# ── Claude via Claude Code (nutzt deine Max-Subscription!) ────
# Auf deinem Rechner einmalig: claude setup-token  → Token hier rein:
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# claude-code (Default) oder api:
CLAUDE_TRANSPORT=claude-code
# Optional festes Modell für Claude Code, sonst dessen Default:
# CLAUDE_CODE_MODEL=claude-sonnet-4-6

# ── Anthropic-API: nur als FALLBACK nötig ─────────────────────
# Achtung: Wenn gesetzt UND CLAUDE_TRANSPORT=api, zahlst du per Token.
# Für den Claude-Code-Prozess wird dieser Key automatisch entfernt,
# damit deine Subscription greift.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (Senior Dev: GPT) ──────────────────────────────────
OPENAI_API_KEY=sk-...
# Prüfe den aktuellen Modellnamen in deinem OpenAI-Dashboard:
OPENAI_MODEL=gpt-5.2

# ── HostYourAI EU-Router (Kimi, Qwen, DeepSeek, GLM) ──────────
HYAI_BASE_URL=https://hostyourai.com/api/v1
HYAI_API_KEY=hyai-...
# Exakte Modell-Slugs im HostYourAI Model Garden nachschauen:
HYAI_MODEL_KIMI=kimi-k3
HYAI_MODEL_QWEN=qwen3.5
HYAI_MODEL_DEEPSEEK=deepseek-v4-pro
HYAI_MODEL_GLM=glm-5.2

# ── Plane (Single Source of Truth) ────────────────────────────
PLANE_BASE_URL=https://plane.deine-domain.de
PLANE_API_KEY=plane_api_...
PLANE_WORKSPACE=dein-workspace-slug
PLANE_PROJECT_ID=projekt-uuid

# ── Optional: TencentDB Agent Memory Proxy ────────────────────
# MEMORY_PROXY_BASE_URL=http://agent-memory:8088/v1

# ── Tuning ────────────────────────────────────────────────────
CONTEXT_CHAR_BUDGET=160000
MAX_MENTION_ROUNDS=2
MAX_TOKENS_MENTION=900
MAX_TOKENS_REVIEW=3000
MAX_TOKENS_CHAIRMAN=6000
