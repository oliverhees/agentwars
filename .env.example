# ── Zugang (PFLICHT) ──────────────────────────────────────────
# Ohne Passwort verweigert die App den Dienst – der Boardroom klont Repos
# und startet Claude Code mit Dateizugriff, das darf nicht offen im Netz stehen.
BOARDROOM_PASSWORD=
# Optional: fester Session-Secret, damit ein Redeploy dich nicht ausloggt.
# Leer = wird pro Start neu gewürfelt.
# BOARDROOM_SECRET=
# BOARDROOM_SESSION_HOURS=168
# auto (Default) | 1 | 0  – Secure-Flag fürs Cookie, auto erkennt HTTPS/Proxy
# BOARDROOM_COOKIE_SECURE=auto
# Nur setzen, wenn die App nachweislich ausschließlich lokal erreichbar ist:
# BOARDROOM_ALLOW_ANONYMOUS=1

# ── Erlaubte Repo-Quellen (PFLICHT für Repo-Analysen) ─────────
# Kommaseparierte Hosts. Leer = Klonen ist komplett deaktiviert.
REPO_ALLOWLIST=github.com

# ── GitHub (PFLICHT) ──────────────────────────────────────────
# Jedes Projekt hängt an einem Repo. Personal Access Token mit Scope 'repo'.
GITHUB_TOKEN=ghp_...
# Nur für GitHub Enterprise anpassen:
# GITHUB_API=https://api.github.com
# GITHUB_HOST=github.com

# ── Persistenz ────────────────────────────────────────────────
# Projekte, Meetings und der komplette Verlauf. Im Container zeigt der
# Pfad auf das Volume /data (siehe docker-compose.yml).
BOARDROOM_DB=data/boardroom.db

# ── Claude via Claude Code (nutzt deine Max-Subscription!) ────
# Auf deinem Rechner einmalig: claude setup-token  → Token hier rein:
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# claude-code (Default) oder api:
CLAUDE_TRANSPORT=claude-code
# Optional festes Modell für Claude Code, sonst dessen Default:
# CLAUDE_CODE_MODEL=claude-sonnet-4-6
# Toolrechte pro Profil. "review" ist der Modus jedes Board-Meetings:
# lesen und suchen, nichts ändern, nichts ausführen.
# CLAUDE_CODE_REVIEW_TOOLS=Read,Grep,Glob,LS,NotebookRead
# "build" ist für die spätere Umsetzungsphase vorbereitet:
# CLAUDE_CODE_BUILD_TOOLS=Read,Grep,Glob,LS,NotebookRead,Edit,Write,Bash

# ── Anthropic-API: nur als FALLBACK nötig ─────────────────────
# Achtung: Wenn gesetzt UND CLAUDE_TRANSPORT=api, zahlst du per Token.
# Für den Claude-Code-Prozess wird dieser Key automatisch entfernt,
# damit deine Subscription greift.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (Senior Dev: GPT) ──────────────────────────────────
OPENAI_API_KEY=sk-...
# Prüfe den aktuellen Modellnamen in deinem OpenAI-Dashboard:
OPENAI_MODEL=gpt-5.2

# ── HostYourAI EU-Router (Kimi, Qwen, DeepSeek, GLM) ──────────
HYAI_BASE_URL=https://hostyourai.com/api/v1
HYAI_API_KEY=hyai-...
# Exakte Modell-Slugs im HostYourAI Model Garden nachschauen:
HYAI_MODEL_KIMI=kimi-k3
HYAI_MODEL_QWEN=qwen3.5
HYAI_MODEL_DEEPSEEK=deepseek-v4-pro
HYAI_MODEL_GLM=glm-5.2

# ── Plane (Single Source of Truth) ────────────────────────────
PLANE_BASE_URL=https://plane.deine-domain.de
PLANE_API_KEY=plane_api_...
PLANE_WORKSPACE=dein-workspace-slug
PLANE_PROJECT_ID=projekt-uuid

# ── Optional: TencentDB Agent Memory Proxy ────────────────────
# MEMORY_PROXY_BASE_URL=http://agent-memory:8088/v1

# ── Preflight ─────────────────────────────────────────────────
# Prüft vor jedem Meeting, ob alle Modelle antworten (6 Mini-Calls).
PREFLIGHT_ON_START=1
PREFLIGHT_TIMEOUT=30

# ── Tuning ────────────────────────────────────────────────────
CONTEXT_CHAR_BUDGET=160000
MAX_MENTION_ROUNDS=2
MAX_TOKENS_MENTION=900
MAX_TOKENS_REVIEW=3000
MAX_TOKENS_CHAIRMAN=6000
